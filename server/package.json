{
  "name": "repairhub-server",
  "version": "1.0.0",
  "description": "RepairHub Backend MVC Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seedData.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "repairhub",
    "mvc",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Group 06 (CSE470)",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "sslcommerz-lts": "^1.2.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mime": "^2.6.0",
    "mime-types": "^3.0.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  },
  "jest": {
    "rootDir": "../",
    "testEnvironment": "node",
    "testTimeout": 15000,
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/server/node_modules"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
